<%# app/views/quarters/new.html.erb %>
<h1>Add quarter</h1>

<%= form_with model: @quarter do |form| %>
  <div>
    <%= form.label :year %>
    <%= form.number_field :year %>
  </div>
  <div>
    <%= form.label :quarter_num %>
    <%= form.number_field :quarter_num, in: 1..4, step: 1 %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<%= link_to "Cancel", quarters_path %>